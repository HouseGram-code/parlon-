# Same Supabase project as the main Parlon site (parlon-app.vercel.app) —
# the developer portal is a second, independent site/deployment that shares
# the same backend/database, so bots created here show up for the same users
# on the main site.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL this portal is deployed at (used to build invite/OAuth
# "Add to server" links like https://<this>/authorize?client_id=...). Leave
# unset locally; set it in Vercel to your real domain.
VITE_PORTAL_URL=https://parlon-developers.vercel.app

# URL of the main messenger (site 1) — linked from the sandbox/playground
# section and the login screen.
VITE_MAIN_APP_URL=https://parlon-app.vercel.app
